# Noto — um app: painel, cadastro, WhatsApp, API fiscal e worker embutido.
# Preencher segredos no ambiente do serviço; não comitar valores reais.

# Servidor único
PORT=3000
HOST=0.0.0.0

# Supabase, banco e criptografia
DATABASE_URL=postgresql://postgres:SENHA_POSTGRES@IP_OU_DOMINIO_VPS:5432/postgres
SUPABASE_URL=https://supabase.seudominio.com
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_gerada_pelo_supabase
ENCRYPTION_KEY=coloque_aqui_uma_chave_simetrica_forte_de_32_caracteres
APP_PEPPER=coloque_aqui_um_pepper_secreto_aleatorio_longo

# Evolution: Noto Oficial (OTP) e WhatsApp dos usuários
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_GLOBAL_API_KEY=sua_global_api_key_da_evolution
EVOLUTION_WEBHOOK_SECRET=segredo_compartilhado_para_validar_webhook
EVOLUTION_OFFICIAL_INSTANCE_NAME=notomed_oficial

# Evolution para avisos de falha fiscal ao médico
EVOLUTION_ASSISTANT_URL=https://evolution-assistente.seudominio.com
EVOLUTION_ASSISTANT_API_KEY=sua_api_key_do_assistente
EVOLUTION_ASSISTANT_INSTANCE_NAME=notomed_assistente
EVOLUTION_ASSISTANT_WEBHOOK_SECRET=segredo_compartilhado_assistente

# Pesquisa cadastral: OpenSerp e extração de CRM/RQE
NVIDIA_API_KEY=
NVIDIA_REGISTRO_MODEL=meta/llama-3.2-90b-vision-instruct
OPENSERP_BASE_URL=
HUB_DESENVOLVEDOR_TOKEN=seu_token_do_hub_aqui

# Emissão e PDF: preservar os valores atuais das proteções fiscais
AGENTE_FISCAL_ATIVO=false
PREPARACAO_FISCAL_ATIVA=false
COMPARACAO_FISCAL_ATIVA=false
MEU_DANFE_API_KEY=sua_api_key_do_meu_danfe_aqui

# Alertas opcionais
RESEND_API_KEY=re_sua_api_key_do_resend
DEV_EMAIL_ALERTA=dev@seudominio.com

# TribeMD validado, acesso administrativo no mesmo app
TRIBEMD_TESTE_ATIVO=false
TRIBEMD_TESTE_ORIGEM=https://seu-dominio
TRIBEMD_TESTE_TOKEN=
TRIBEMD_TESTE_CHAVE=
TRIBEMD_TESTE_DIRETORIO=/dados/tribemd

# O cofre TribeMD exige chave estável de 32 bytes em base64, token próprio e volume persistente.
# CHROMIUM_EXECUTABLE_PATH e XVFB_EXECUTABLE_PATH são opcionais; a imagem já inclui ambos.
# AGENTE_FISCAL_ATIVO controla proteções da fila/emissor; os agentes antigos foram removidos.
