# =============================================================================
# NOTOMED WHATS — VARIÁVEIS DE AMBIENTE (Easypanel / Hostinger VPS)
# =============================================================================

# Porta do servidor HTTP da aplicação
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 1. POSTGRES / SUPABASE (Self-hosted no Easypanel)
# -----------------------------------------------------------------------------
# String de conexão direta com o Postgres do Supabase (com permissão para pgcrypto)
DATABASE_URL=postgresql://postgres:SENHA_POSTGRES@IP_OU_DOMINIO_VPS:5432/postgres

# URL e Service Role Key do Supabase (para Auth Admin API e Storage)
SUPABASE_URL=https://supabase.seudominio.com
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_gerada_pelo_supabase

# -----------------------------------------------------------------------------
# 2. SEGREDOS E CRIPTOGRAFIA (pgcrypto & HMAC)
# -----------------------------------------------------------------------------
# Chave simétrica para encriptar/decriptar CPF e dados sensíveis via pgp_sym_encrypt/pgp_sym_decrypt
ENCRYPTION_KEY=coloque_aqui_uma_chave_simetrica_forte_de_32_caracteres

# Pepper da aplicação para HMAC-SHA256 (hash de OTP e busca indexada de CPF)
APP_PEPPER=coloque_aqui_um_pepper_secreto_aleatorio_longo

# -----------------------------------------------------------------------------
# 3. EVOLUTION API (Containers no Easypanel)
# -----------------------------------------------------------------------------
# URL da Evolution API e chave de API global
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_GLOBAL_API_KEY=sua_global_api_key_da_evolution

# Segredo compartilhado configurado no webhook da Evolution API
EVOLUTION_WEBHOOK_SECRET=segredo_compartilhado_para_validar_webhook

# Nome da instância oficial da plataforma (número próprio para avisos e envio de OTP)
EVOLUTION_OFFICIAL_INSTANCE_NAME=notomed_oficial

# -----------------------------------------------------------------------------
# 4. ALERTAS E E-MAIL (Resend)
# -----------------------------------------------------------------------------
# Usado para enviar alertas de erros inesperados ao desenvolvedor e envio de NFS-e por e-mail
RESEND_API_KEY=re_sua_api_key_do_resend
DEV_EMAIL_ALERTA=dev@seudominio.com

# -----------------------------------------------------------------------------
# 5. IA / GROQ (Extração de dados de conversas e mensagens)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_sua_api_key_do_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# 6. MEU DANFE (API v2 - Conversão Grátis de XML para DANFSe PDF)
# -----------------------------------------------------------------------------
# Obtenha sua Api-Key gratuita em https://web.meudanfe.com.br/signed/apikey
MEU_DANFE_API_KEY=sua_api_key_do_meu_danfe_aqui

# -----------------------------------------------------------------------------
# 7. HUB DO DESENVOLVEDOR (Consulta Cadastral de CPF)
# -----------------------------------------------------------------------------
# Obtenha seu token em https://hubdodesenvolvedor.com.br
HUB_DESENVOLVEDOR_TOKEN=seu_token_do_hub_aqui

# -----------------------------------------------------------------------------
# 8. STRIPE BILLING (Assinaturas e Limites de Emissão)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_sua_chave_secreta_stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_sua_chave_publica_stripe
STRIPE_PRICE_ID=price_seu_price_id_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui
# Aplicar scripts/migrar-investigacoes-emissao.mjs antes de habilitar em TODOS os workers.
# Requer GROQ_API_KEY. Desligado mantém o comportamento anterior.
AGENTE_FISCAL_ATIVO=false

# Aplicar npm run migrate:preparacao e revisar regras fiscais antes de habilitar.
# Requer AGENTE_FISCAL_ATIVO=true para investigar pendências antes do envio.
PREPARACAO_FISCAL_ATIVA=false
TREINO_ONBOARDING_ATIVO=false
COMPARACAO_FISCAL_ATIVA=false

# Área interna /desenvolvedor. Homologação apenas; não usa dados/filas de produção.
DESENVOLVEDOR_FISCAL_ATIVO=false
# Gere uma chave aleatória própria (32 a 256 caracteres); não reutilize chaves de APIs.
DESENVOLVEDOR_FISCAL_TOKEN=

# Google Planilhas (OAuth cliente Web, API Sheets habilitada; apenas leitura).
# Aplicar npm run migrate:planilhas antes de configurar a conexão.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio/api/integracoes/google-planilhas/callback
