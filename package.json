{
  "name": "notomed-whats",
  "version": "0.1.0",
  "description": "Sistema de emissão de NFS-e para médicos via WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/server.ts",
    "worker": "node --import tsx src/worker-runner.ts",
    "migrate:agente": "node scripts/migrar-investigacoes-emissao.mjs",
    "check:agente": "node scripts/verificar-agente-fiscal.mjs",
    "migrate:preparacao": "node scripts/migrar-preparacao-fiscal.mjs"
  },
  "keywords": [
    "nfse",
    "whatsapp",
    "medicos",
    "saas"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6"
  },
  "dependencies": {
    "@nfewizard/types": "^1.0.11",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "xml-crypto": "^6.3.2",
    "zod": "^3.24.0"
  }
